[Unit]
Description=Automatically login to shinshu-u wifi
[Service]
ExecStart="/home/moamoa/.cargo/bin/autoconnect"
LoadCredential=uid:/etc/secrets/shinshu-password/uid
LoadCredential=pwd:/etc/secrets/shinshu-password/pwd
Restart=on-failure
[Install]
WantedBy=default.target
[Service]
StandardOutput=journal
StandardError=journal
